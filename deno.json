{
  "name": "@ball6847/maar",
  "version": "1.1.0",
  "exports": "./maar.ts",
  "publish": {
    "include": [
      "maar.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ]
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write maar.ts",
    "test": "deno test --allow-read --allow-write --allow-run",
    "check": "deno check maar.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "publish:dry": "deno publish --dry-run"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "beautiful-mermaid": "npm:beautiful-mermaid@^1.1.3"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "include": ["src/", "maar.ts", "test/"]
  }
}
